<?xml version="1.0" ?>
<materialLib name="Mesh">
	<shaders>
		<shader name="meshShader" 		ms = "shaders/trianglePlusII.mesh" 
										ps = "shaders/dirdifambpix.frag" />
	</shaders>
	
	<materials>
		<material name="meshShader">
			<shader name="meshShader" >
				<values>
					<valueof uniform="m_pvm" 
							 type="RENDERER"  
							 component="PROJECTION_VIEW_MODEL" />
							 
					<valueof uniform="m_normal" 
							 type="RENDERER"  
							 component="NORMAL" />
							 
					<valueof uniform="m_view" 
							 type="RENDERER"  
							 component="VIEW" />
							 
					<valueof uniform="diffuse" 
							 type="COLOR" 
							 component="DIFFUSE" />
							 
					<valueof uniform="l_dir" 
							 type="LIGHT" context="Sun"
							 component="DIRECTION" />
				</values>
			</shader>
		</material>
	</materials>
</materialLib>